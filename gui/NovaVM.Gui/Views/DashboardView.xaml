<UserControl x:Class="NovaVM.Gui.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NovaVM.Gui.ViewModels"
             xmlns:models="clr-namespace:NovaVM.Gui.Models"
             xmlns:markup="clr-namespace:NovaVM.Gui.Markup"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">

            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{markup:Tr Nav_Dashboard}" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{markup:Tr Dashboard_Subtitle}" FontSize="13"
                               Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding RefreshCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="{markup:Tr Common_Refresh}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <UniformGrid Columns="3" Margin="0,0,0,24" Rows="1">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Style="{StaticResource SmallIconBadgeStyle}"
                                    Background="{StaticResource IconBlueBrush}" Margin="0,0,10,0">
                                <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="17"
                                               Foreground="{StaticResource IconBlueForeground}" />
                            </Border>
                            <TextBlock Text="CPU" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock FontSize="30" FontWeight="Bold" Margin="0,8,0,10"
                                   Foreground="{StaticResource TextPrimaryBrush}">
                            <Run Text="{Binding Stats.CpuUsagePercent, Mode=OneWay}" /><Run Text="%" />
                        </TextBlock>
                        <ProgressBar Value="{Binding Stats.CpuUsagePercent, Mode=OneWay}" Maximum="100" Height="6"
                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource SliderTrackBrush}"
                                     BorderThickness="0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="8,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Style="{StaticResource SmallIconBadgeStyle}"
                                    Background="{StaticResource IconPurpleBrush}" Margin="0,0,10,0">
                                <ui:SymbolIcon Symbol="Ram20" FontSize="17"
                                               Foreground="{StaticResource IconPurpleForeground}" />
                            </Border>
                            <TextBlock Text="RAM" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock FontSize="30" FontWeight="Bold" Margin="0,8,0,10"
                                   Foreground="{StaticResource TextPrimaryBrush}">
                            <Run Text="{Binding Stats.RamUsedGb, Mode=OneWay}" /><Run Text=" / " /><Run
                                Text="{Binding Stats.RamTotalGb, Mode=OneWay}" /><Run Text="{markup:Tr Common_GbUnit}" />
                        </TextBlock>
                        <ProgressBar Value="{Binding Stats.RamUsagePercent, Mode=OneWay}" Maximum="100" Height="6"
                                     Foreground="{StaticResource SecondaryAccentBrush}" Background="{StaticResource SliderTrackBrush}"
                                     BorderThickness="0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Style="{StaticResource SmallIconBadgeStyle}"
                                    Background="{StaticResource IconAccentBrush}" Margin="0,0,10,0">
                                <ui:SymbolIcon Symbol="Database24" FontSize="17"
                                               Foreground="{StaticResource IconAccentForeground}" />
                            </Border>
                            <TextBlock Text="{markup:Tr Nav_Storage}" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock FontSize="30" FontWeight="Bold" Margin="0,8,0,10"
                                   Foreground="{StaticResource TextPrimaryBrush}">
                            <Run Text="{Binding Stats.StorageUsedGb, Mode=OneWay}" /><Run Text=" / " /><Run
                                Text="{Binding Stats.StorageTotalGb, Mode=OneWay}" /><Run Text="{markup:Tr Common_GbUnit}" />
                        </TextBlock>
                        <ProgressBar Value="{Binding Stats.StorageUsagePercent, Mode=OneWay}" Maximum="100" Height="6"
                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource SliderTrackBrush}"
                                     BorderThickness="0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="20,18,20,8">
                        <ui:SymbolIcon Symbol="Desktop24" FontSize="17" VerticalAlignment="Center" Margin="0,0,10,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{markup:Tr Nav_VmList}" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Border Style="{StaticResource CountBadgeStyle}" Margin="10,0,0,0">
                            <TextBlock Text="{Binding Vms.Count}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Vms}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:VirtualMachine}">
                                <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush2}"
                                        Padding="20,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="260" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource SmallIconBadgeStyle}"
                                                Background="{StaticResource IconBlueBrush}" Margin="0,0,12,0">
                                            <ui:SymbolIcon Symbol="Desktop24" FontSize="16"
                                                           Foreground="{StaticResource IconBlueForeground}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <Border Grid.Column="2" CornerRadius="10" Padding="10,4" HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="{Binding State, Converter={StaticResource VmStateToBrushConverter}}">
                                            <TextBlock Text="{Binding StateDisplay}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#0A0E12" />
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="{Binding DisplaySummary}" FontSize="12"
                                                   VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{markup:Tr Dashboard_NoVms}" Margin="20,4,20,18"
                               Foreground="{StaticResource TextMutedBrush}"
                               Visibility="{Binding Vms.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Invert}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:SymbolIcon Symbol="Warning24" FontSize="17" VerticalAlignment="Center" Margin="0,0,10,0"
                                       Foreground="{StaticResource WarningBrush}" />
                        <TextBlock Text="{markup:Tr Dashboard_RecentAlerts}" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Alerts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:LogEntry}">
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="{Binding Icon}" Foreground="{StaticResource WarningBrush}" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding Alerts.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Invert}">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="{markup:Tr Dashboard_NoAlerts}" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
