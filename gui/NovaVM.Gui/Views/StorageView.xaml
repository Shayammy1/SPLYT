<UserControl x:Class="NovaVM.Gui.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NovaVM.Gui.ViewModels"
             xmlns:models="clr-namespace:NovaVM.Gui.Models"
             xmlns:markup="clr-namespace:NovaVM.Gui.Markup"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:StorageViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{markup:Tr Nav_Storage}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{markup:Tr Storage_Subtitle}" FontSize="13" Margin="0,4,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Content="{markup:Tr Common_Refresh}" Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
            </Grid>

            <Border Style="{StaticResource CardStyle}" Padding="0">
                <StackPanel>
                    <Grid Margin="20,16,20,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{markup:Tr Storage_ColumnFile}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Grid.Column="1" Text="{markup:Tr Storage_ColumnSize}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Grid.Column="2" Text="{markup:Tr Storage_ColumnAttachedVm}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Disks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:VirtualDisk}">
                                <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush2}" Padding="20,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Path}" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <ProgressBar Value="{Binding UsagePercent, Mode=OneWay}" Maximum="100" Height="4"
                                                         Margin="0,6,0,0" Foreground="{StaticResource AccentBrush}"
                                                         Background="{StaticResource SurfaceElevatedBrush}" BorderThickness="0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="{Binding UsedGb, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding SizeGb, Mode=OneWay}" /><Run Text="{markup:Tr Common_GbUnit}" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding AttachedVm, Converter={StaticResource FallbackTextConverter}, ConverterParameter={markup:Tr Storage_NoneAttached}}"
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{markup:Tr Storage_NoDisks}" Margin="20,4,20,18"
                               Foreground="{StaticResource TextMutedBrush}"
                               Visibility="{Binding Disks.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Invert}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
