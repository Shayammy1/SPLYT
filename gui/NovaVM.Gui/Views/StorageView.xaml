<UserControl x:Class="NovaVM.Gui.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NovaVM.Gui.ViewModels"
             xmlns:models="clr-namespace:NovaVM.Gui.Models"
             xmlns:markup="clr-namespace:NovaVM.Gui.Markup"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:StorageViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{markup:Tr Nav_Storage}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{markup:Tr Storage_Subtitle}" FontSize="13" Margin="0,4,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding RefreshCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="{markup:Tr Common_Refresh}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Padding="0">
                <StackPanel>
                    <Grid Margin="20,16,20,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="{markup:Tr Storage_ColumnFile}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Grid.Column="2" Text="{markup:Tr Storage_ColumnSize}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Grid.Column="3" Text="{markup:Tr Storage_ColumnAttachedVm}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Disks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:VirtualDisk}">
                                <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush2}" Padding="20,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource SmallIconBadgeStyle}"
                                                Background="{StaticResource IconAccentBrush}" HorizontalAlignment="Left">
                                            <ui:SymbolIcon Symbol="Database24" FontSize="16"
                                                           Foreground="{StaticResource IconAccentForeground}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Path}" FontWeight="SemiBold" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <ProgressBar Value="{Binding UsagePercent, Mode=OneWay}" Maximum="100" Height="4"
                                                         Margin="0,6,12,0" Foreground="{StaticResource AccentBrush}"
                                                         Background="{StaticResource SliderTrackBrush}" BorderThickness="0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="{Binding UsedGb, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding SizeGb, Mode=OneWay}" /><Run Text="{markup:Tr Common_GbUnit}" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="3" Text="{Binding AttachedVm, Converter={StaticResource FallbackTextConverter}, ConverterParameter={markup:Tr Storage_NoneAttached}}"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="20,16,20,26" HorizontalAlignment="Center"
                                Visibility="{Binding Disks.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Invert}">
                        <Border Style="{StaticResource IconBadgeStyle}" Width="56" Height="56" CornerRadius="16"
                                HorizontalAlignment="Center" Margin="0,0,0,14">
                            <ui:SymbolIcon Symbol="Database24" FontSize="26"
                                           Foreground="{StaticResource TextMutedBrush}" />
                        </Border>
                        <TextBlock Text="{markup:Tr Storage_NoDisks}" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
