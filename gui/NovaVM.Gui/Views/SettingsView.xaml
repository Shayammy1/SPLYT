<UserControl x:Class="NovaVM.Gui.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NovaVM.Gui.ViewModels"
             xmlns:markup="clr-namespace:NovaVM.Gui.Markup"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}">
    <UserControl.Resources>
        <Style x:Key="DiagStatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="Text" Value="{markup:Tr Common_No}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                    <Setter Property="Text" Value="{markup:Tr Common_Yes}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="640">
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{markup:Tr Settings_Title}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{markup:Tr Settings_Subtitle}" FontSize="13"
                               Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Content="{markup:Tr Settings_RefreshDiagnostics}" Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding RefreshDiagnosticsCommand}" VerticalAlignment="Center" />
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{markup:Tr Settings_DiagnosticTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{markup:Tr Settings_HyperVModuleInstalled}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                        <TextBlock Grid.Column="1" Style="{StaticResource DiagStatusText}"
                                   DataContext="{Binding Diagnostics.HyperVModuleInstalled}" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{markup:Tr Settings_CanListVms}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                        <TextBlock Grid.Column="1" Style="{StaticResource DiagStatusText}"
                                   DataContext="{Binding Diagnostics.CanListVms}" />
                    </Grid>
                    <TextBlock Text="{Binding Diagnostics.VmPermissionError}" TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"
                               Visibility="{Binding Diagnostics.VmPermissionError, Converter={StaticResource NullToVisibilityConverter}}" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{markup:Tr Settings_CanListGpus}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                        <TextBlock Grid.Column="1" Style="{StaticResource DiagStatusText}"
                                   DataContext="{Binding Diagnostics.CanListPartitionableGpus}" />
                    </Grid>
                    <TextBlock Text="{Binding Diagnostics.GpuPermissionError}" TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"
                               Visibility="{Binding Diagnostics.GpuPermissionError, Converter={StaticResource NullToVisibilityConverter}}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{markup:Tr Settings_IsElevated}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                        <TextBlock Grid.Column="1" Style="{StaticResource DiagStatusText}"
                                   DataContext="{Binding Diagnostics.IsElevated}" />
                    </Grid>

                    <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               Text="{markup:Tr Settings_DiagnosticNote}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{markup:Tr Settings_LanguageTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <TextBlock Text="{markup:Tr Settings_LanguageNote}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />

                    <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage}"
                              Width="220" HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource AppLanguageToLabelConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0"
                                Visibility="{Binding LanguageChanged, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{markup:Tr Settings_LanguageRestartNotice}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,12,0" />
                        <Button Content="{markup:Tr Settings_RestartNow}" Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding RestartNowCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{markup:Tr Settings_PreferencesTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <TextBlock Text="{markup:Tr Settings_DefaultDiskPath}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding DefaultDiskPath}" Margin="0,6,0,16" />

                    <CheckBox Content="{markup:Tr Settings_AutoSelectGpu}" IsChecked="{Binding AutoSelectGpu}"
                              Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                    <CheckBox Content="{markup:Tr Settings_DarkTheme}" IsChecked="{Binding DarkTheme}"
                              Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{markup:Tr Settings_PreferencesNote}"
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{markup:Tr Settings_AboutTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding AppVersion}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{markup:Tr Settings_AboutRoadmap}"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
