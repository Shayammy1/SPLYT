<UserControl x:Class="NovaVM.Gui.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NovaVM.Gui.ViewModels"
             xmlns:markup="clr-namespace:NovaVM.Gui.Markup"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}">
    <UserControl.Resources>
        <Style x:Key="DiagStatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="Text" Value="{markup:Tr Common_No}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                    <Setter Property="Text" Value="{markup:Tr Common_Yes}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Meme information que DiagStatusText, en icone : dans une liste de
             quatre lignes, une coche verte ou une croix rouge se lit d'un coup
             d'oeil la ou "Oui"/"Non" demande de lire. -->
        <Style x:Key="DiagStatusIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="Symbol" Value="DismissCircle24" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                    <Setter Property="Symbol" Value="CheckmarkCircle24" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="640">
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{markup:Tr Settings_Title}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{markup:Tr Settings_Subtitle}" FontSize="13"
                               Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding RefreshDiagnosticsCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="{markup:Tr Settings_RefreshDiagnostics}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Style="{StaticResource SmallIconBadgeStyle}" Background="{StaticResource IconBlueBrush}" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Stethoscope24" FontSize="17" Foreground="{StaticResource IconBlueForeground}" />
                        </Border>
                        <TextBlock Text="{markup:Tr Settings_DiagnosticTitle}" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{markup:Tr Settings_HyperVModuleInstalled}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" DataContext="{Binding Diagnostics.HyperVModuleInstalled}">
                            <ui:SymbolIcon Style="{StaticResource DiagStatusIcon}" />
                            <TextBlock Style="{StaticResource DiagStatusText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{markup:Tr Settings_CanListVms}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" DataContext="{Binding Diagnostics.CanListVms}">
                            <ui:SymbolIcon Style="{StaticResource DiagStatusIcon}" />
                            <TextBlock Style="{StaticResource DiagStatusText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Diagnostics.VmPermissionError}" TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"
                               Visibility="{Binding Diagnostics.VmPermissionError, Converter={StaticResource NullToVisibilityConverter}}" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{markup:Tr Settings_CanListGpus}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" DataContext="{Binding Diagnostics.CanListPartitionableGpus}">
                            <ui:SymbolIcon Style="{StaticResource DiagStatusIcon}" />
                            <TextBlock Style="{StaticResource DiagStatusText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Diagnostics.GpuPermissionError}" TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"
                               Visibility="{Binding Diagnostics.GpuPermissionError, Converter={StaticResource NullToVisibilityConverter}}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{markup:Tr Settings_IsElevated}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" DataContext="{Binding Diagnostics.IsElevated}">
                            <ui:SymbolIcon Style="{StaticResource DiagStatusIcon}" />
                            <TextBlock Style="{StaticResource DiagStatusText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               Text="{markup:Tr Settings_DiagnosticNote}" />

                    <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,16,0,16" />

                    <TextBlock Text="{markup:Tr Settings_ReportTitle}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                    <TextBlock Text="{markup:Tr Settings_ReportDesc}" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />
                    <Button Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding CopyDiagnosticReportCommand}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Copy24" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="{markup:Tr Settings_CopyReport}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding CopyReportStatus}" FontSize="11.5" TextWrapping="Wrap" Margin="0,10,0,0"
                               Foreground="{StaticResource SuccessBrush}"
                               Visibility="{Binding CopyReportStatus, Converter={StaticResource NullToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Style="{StaticResource SmallIconBadgeStyle}" Background="{StaticResource IconPurpleBrush}" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="LocalLanguage24" FontSize="17" Foreground="{StaticResource IconPurpleForeground}" />
                        </Border>
                        <TextBlock Text="{markup:Tr Settings_LanguageTitle}" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>

                    <TextBlock Text="{markup:Tr Settings_LanguageNote}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />

                    <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage}"
                              Width="220" HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource AppLanguageToLabelConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0"
                                Visibility="{Binding LanguageChanged, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{markup:Tr Settings_LanguageRestartNotice}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,12,0" />
                        <Button Content="{markup:Tr Settings_RestartNow}" Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding RestartNowCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Style="{StaticResource SmallIconBadgeStyle}" Background="{StaticResource IconAccentBrush}" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Options24" FontSize="17" Foreground="{StaticResource IconAccentForeground}" />
                        </Border>
                        <TextBlock Text="{markup:Tr Settings_PreferencesTitle}" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>

                    <TextBlock Text="{markup:Tr Settings_DefaultDiskPath}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding DefaultDiskPath}" Margin="0,6,0,16" />

                    <CheckBox Content="{markup:Tr Settings_AutoSelectGpu}" IsChecked="{Binding AutoSelectGpu}"
                              Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                    <CheckBox Content="{markup:Tr Settings_DarkTheme}" IsChecked="{Binding DarkTheme}"
                              Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{markup:Tr Settings_PreferencesNote}"
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Style="{StaticResource SmallIconBadgeStyle}" Background="{StaticResource IconNeutralBrush}" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Info24" FontSize="17" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                        <TextBlock Text="{markup:Tr Settings_AboutTitle}" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding AppVersion}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{markup:Tr Settings_AboutRoadmap}"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
