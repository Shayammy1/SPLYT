<UserControl x:Class="NovaVM.Gui.Controls.CreateVmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NovaVM.Gui.ViewModels"
             xmlns:markup="clr-namespace:NovaVM.Gui.Markup"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CreateVmDialogViewModel}">
    <Grid>
        <Border Style="{StaticResource CardStyle}" Width="460" MaxHeight="640"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{markup:Tr CreateVm_Title}" FontSize="20" FontWeight="Bold"
                           Margin="0,0,0,18" Foreground="{StaticResource TextPrimaryBrush}" />

                <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                    <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                                Margin="0,0,0,10">
                        <TextBlock Text="{Binding CurrentStep}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                                     Height="6" />
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"
                               FontSize="12" Margin="0,0,0,10"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{markup:Tr Common_Cancel}" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding CancelCommand}" Margin="0,0,10,0" />
                        <Button Content="{markup:Tr Common_Create}" Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding CreateCommand}" />
                    </StackPanel>
                </StackPanel>

                <!-- Marge droite : sans elle, la barre de defilement se superpose a la fin
                     des lignes de texte du panneau (constate a l'usage). -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="{markup:Tr CreateVm_Name}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,16" />

                        <TextBlock Text="{markup:Tr VmList_Res_Vcpu}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <Grid Margin="0,6,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="1" Maximum="{Binding MaxCpu}" Value="{Binding Cpu}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Cpu}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16">
                            <Run Text="{markup:Tr VmList_Res_CpuDetected}" /><Run Text="{Binding CpuCores, Mode=OneWay}" /><Run Text="{markup:Tr VmList_Res_CpuCores}" /><Run Text="{Binding CpuLogicalProcessors, Mode=OneWay}" /><Run Text="{markup:Tr VmList_Res_CpuThreads}" />
                        </TextBlock>

                        <TextBlock Text="{markup:Tr VmList_Res_Ram}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <Grid Margin="0,6,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="1" Maximum="{Binding MaxMemoryGb}" Value="{Binding MemoryGb}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding MemoryGb}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4">
                            <Run Text="{markup:Tr VmList_Res_PhysicalRamDetected}" /><Run Text="{Binding TotalPhysicalRamGb, Mode=OneWay}" /><Run Text="{markup:Tr VmList_Res_MaxForVm}" /><Run Text="{Binding MaxMemoryGb, Mode=OneWay}" /><Run Text="{markup:Tr Common_GbUnit}" />
                        </TextBlock>
                        <TextBlock Text="{markup:Tr VmList_Res_RamWarning}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource WarningBrush}" Margin="0,0,0,16" TextWrapping="Wrap"
                                   Visibility="{Binding ShowRamWarning, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <CheckBox Content="{markup:Tr Vm_DynamicMemory}" IsChecked="{Binding DynamicMemoryEnabled}"
                                  Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"
                                  ToolTip="{markup:Tr Vm_DynamicMemory_Tooltip}" />

                        <TextBlock Text="{markup:Tr CreateVm_Disk}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <Grid Margin="0,6,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="16" Maximum="512" Value="{Binding DiskSizeGb}" TickFrequency="16" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding DiskSizeGb}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock Text="GPU (GPU-P)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding AvailableGpus}" SelectedItem="{Binding SelectedGpu}" Margin="0,6,0,16" />

                        <TextBlock Text="{markup:Tr VmList_Gpu_VramAllocated}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <StackPanel Margin="0,6,0,16">
                            <Grid IsEnabled="{Binding HasDedicatedVram}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="512" Maximum="{Binding MaxGpuVramMb}" Value="{Binding GpuVramMb}" TickFrequency="512" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding GpuVramMb}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock Text="{markup:Tr VmList_Gpu_NoDedicatedVram}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"
                                       Visibility="{Binding NoDedicatedVram, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <TextBlock Text="{markup:Tr CreateVm_IsoLabel}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <Grid Margin="0,6,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding IsoPath, Mode=OneWay}" IsReadOnly="True"
                                     ToolTip="{Binding IsoPath}" />
                            <Button Grid.Column="2" Content="{markup:Tr Common_Browse}" Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding BrowseIsoCommand}" />
                        </Grid>

                        <Button Content="{markup:Tr CreateVm_DownloadIso}" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding DownloadWindowsIsoCommand}" HorizontalAlignment="Left" Margin="0,4,0,4"
                                Visibility="{Binding NoIsoYet, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTip="{markup:Tr CreateVm_DownloadIso_Tooltip}" />
                        <TextBlock Text="{Binding IsoDownloadStatusText}" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"
                                   Visibility="{Binding IsoDownloadStatusText, Converter={StaticResource NullToVisibilityConverter}}" />

                        <TextBlock Text="{markup:Tr CreateVm_NoIsoNote}"
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
