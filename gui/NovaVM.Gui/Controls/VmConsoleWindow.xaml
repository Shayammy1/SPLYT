<ui:FluentWindow x:Class="NovaVM.Gui.Controls.VmConsoleWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:markup="clr-namespace:NovaVM.Gui.Markup"
                 xmlns:controls="clr-namespace:NovaVM.Gui.Controls"
                 Title="SPLYT"
                 Width="1100" Height="760"
                 MinWidth="480" MinHeight="360"
                 WindowStartupLocation="CenterScreen"
                 Background="{StaticResource BackgroundBrush}"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barre de titre native (deplacement, reduire/agrandir/fermer). -->
        <ui:TitleBar x:Name="TitleStrip" Grid.Row="0" Title="SPLYT"
                     Icon="{ui:ImageIcon 'pack://application:,,,/Assets/AppIcon.ico'}" />

        <!-- Barre d'outils de la console. Volontairement SOUS la barre de titre et
             non dedans : la bande de titre est traitee comme zone de caption par
             WindowChrome, et les clics y servent a deplacer la fenetre au lieu
             d'atteindre les boutons (verifie - le clic tombait au bon pixel sans
             rien declencher). Ici, ce sont des controles WPF ordinaires. -->
        <Border x:Name="HeaderBar" Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,1"
                Padding="14,6">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border Style="{StaticResource SmallIconBadgeStyle}"
                            Background="{StaticResource IconBlueBrush}" Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="Desktop24" FontSize="16"
                                       Foreground="{StaticResource IconBlueForeground}" />
                    </Border>
                    <TextBlock x:Name="VmNameText" FontWeight="SemiBold" FontSize="13"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock x:Name="VideoSizeText" FontSize="11" Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButtonStyle}" Padding="12,6"
                            Click="OnSendCtrlAltDel"
                            ToolTip="{markup:Tr Console_SendCtrlAltDel}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Keyboard24" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Ctrl+Alt+Suppr" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButtonStyle}" Padding="12,6" Margin="8,0,0,0"
                            Click="OnToggleFullScreen"
                            ToolTip="{markup:Tr Console_FullScreen}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon x:Name="FullScreenIcon" Symbol="FullScreenMaximize24"
                                           FontSize="14" Margin="0,0,8,0" />
                            <TextBlock x:Name="FullScreenLabel" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ConsoleArea" Grid.Row="2" Background="{StaticResource BackgroundBrush}">
            <!-- Centre par WPF : la console fait exactement la taille de la video
                 (voir VmConsoleHost.MeasureOverride), le fond SPLYT occupe le reste
                 quand la fenetre est plus grande - notamment en plein ecran ou la
                 VM ne remplit pas l'ecran de l'hote. -->
            <controls:VmConsoleHost x:Name="Console"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />

            <!-- En plein ecran, la barre d'outils disparait : ce rappel indique
                 comment revenir, sinon on ne trouve plus le bouton. -->
            <Border x:Name="FullScreenHint" Visibility="Collapsed"
                    VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1" CornerRadius="8" Padding="12,6" Opacity="0.92">
                <TextBlock Text="{markup:Tr Console_FullScreenHint}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
