<UserControl x:Class="NovaVM.Gui.Controls.HyperVSetupDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NovaVM.Gui.ViewModels"
             xmlns:markup="clr-namespace:NovaVM.Gui.Markup"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HyperVSetupDialogViewModel}">
    <Grid>
        <Border Style="{StaticResource CardStyle}" Width="440"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="{markup:Tr HyperV_Title}" FontSize="18" FontWeight="Bold"
                           Margin="0,0,0,6" Foreground="{StaticResource TextPrimaryBrush}" />

                <!-- Invite initiale (avant activation) -->
                <StackPanel Visibility="{Binding Result, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,18"
                               Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="{markup:Tr HyperV_Prompt}" />
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,18">
                        <Run Text="{markup:Tr HyperV_EditionNote}" />
                    </TextBlock>

                    <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,10">
                        <TextBlock Text="{markup:Tr HyperV_InProgress}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <ProgressBar IsIndeterminate="True" Height="6" />
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"
                               FontSize="12" Margin="0,0,0,10"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{markup:Tr Common_Later}" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding DismissCommand}" Margin="0,0,10,0" />
                        <Button Content="{markup:Tr HyperV_EnableNow}" Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding EnableCommand}" />
                    </StackPanel>
                </StackPanel>

                <!-- Resultat (apres activation) -->
                <StackPanel Visibility="{Binding Result, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="{Binding Result.Message}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,18"
                               Foreground="{StaticResource TextSecondaryBrush}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Visibility="{Binding RebootRequired, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Content="{markup:Tr Common_Later}" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding DismissCommand}" Margin="0,0,10,0" />
                        <Button Content="{markup:Tr Settings_RestartNow}" Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding RestartNowCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Visibility="{Binding NoRebootRequired, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Content="{markup:Tr Common_Close}" Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding DismissCommand}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
