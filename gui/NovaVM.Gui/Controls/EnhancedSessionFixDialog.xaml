<UserControl x:Class="NovaVM.Gui.Controls.EnhancedSessionFixDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NovaVM.Gui.ViewModels"
             xmlns:markup="clr-namespace:NovaVM.Gui.Markup"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:EnhancedSessionFixDialogViewModel}">
    <Grid>
        <Border Style="{StaticResource CardStyle}" Width="420"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{markup:Tr VmList_Display_FixEnhancedSession}" FontSize="18" FontWeight="Bold"
                           TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,18"
                           Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="{markup:Tr EnhancedSession_Description}" />
                </TextBlock>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                    <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,10">
                        <TextBlock Text="{markup:Tr EnhancedSession_InProgress}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <ProgressBar IsIndeterminate="True" Height="6" />
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"
                               FontSize="12" Margin="0,0,0,10"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{markup:Tr Common_Cancel}" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding CancelCommand}" Margin="0,0,10,0" />
                        <Button Content="{markup:Tr EnhancedSession_FixButton}" Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding FixCommand}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel>
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap">
                        <Run Text="{markup:Tr Common_VmLabel}" /><Run Text="{Binding VmName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </TextBlock>

                    <TextBlock Text="{markup:Tr VmList_Credentials_UsernameLabel}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,4" />
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16">
                        <Run Text="{markup:Tr VmList_Credentials_MicrosoftHint_Part1}" />
                        <Run Text="moncomptemicrosoft@gmail.com" FontStyle="Italic" />
                        <Run Text="{markup:Tr VmList_Credentials_MicrosoftHint_Part2}" />
                    </TextBlock>

                    <TextBlock Text="{markup:Tr VmList_Credentials_PasswordLabel}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    <PasswordBox x:Name="PasswordInput" Margin="0,6,0,16" />

                    <CheckBox Content="{markup:Tr VmList_Credentials_Remember}" IsChecked="{Binding RememberCredentials}" Margin="0,0,0,10"
                              Foreground="{StaticResource TextPrimaryBrush}" />

                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                        <Run Text="{markup:Tr VmList_Credentials_StorageNote}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
