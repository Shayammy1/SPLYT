<UserControl x:Class="NovaVM.Gui.Controls.MoonlightLaunchDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NovaVM.Gui.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MoonlightLaunchDialogViewModel}">
    <Grid>
        <Border Style="{StaticResource CardStyle}" Width="440"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding Subtitle}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,18"
                           Foreground="{StaticResource TextSecondaryBrush}" />

                <TextBlock Text="{Binding ResolutionLabel}" FontSize="12" Margin="0,0,0,6"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedResolution}"
                          Margin="0,0,0,14" />

                <TextBlock Text="{Binding RefreshRateLabel}" FontSize="12" Margin="0,0,0,6"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding RefreshRates}" SelectedItem="{Binding SelectedRefreshRate}"
                          Margin="0,0,0,14">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat={}{0} Hz}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="{Binding Hint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,20"
                           Foreground="{StaticResource TextMutedBrush}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding CancelLabel}" Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding CancelCommand}" Margin="0,0,10,0" />
                    <Button Content="{Binding LaunchLabel}" Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding LaunchCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
