<UserControl x:Class="NovaVM.Gui.Controls.SplytSetupDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NovaVM.Gui.ViewModels"
             xmlns:markup="clr-namespace:NovaVM.Gui.Markup"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SplytSetupDialogViewModel}">
    <Grid>
        <Border Style="{StaticResource CardStyle}" Width="520" MaxHeight="660"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBlock Text="{markup:Tr Splyt_Title}" FontSize="19" FontWeight="Bold"
                               TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding VmName}" FontSize="12" Margin="0,2,0,0"
                               Foreground="{StaticResource AccentBrush}" />
                </StackPanel>

                <!-- Zone basse : progression, bouton principal, compte rendu -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                                Margin="0,0,0,12">
                        <TextBlock Text="{Binding CurrentStep}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" Height="6" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{markup:Tr Common_Close}" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding CloseCommand}" Margin="0,0,10,0" />
                        <Button Content="SPLYT" Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding RunCommand}" FontSize="15" FontWeight="Bold" Padding="28,11"
                                Visibility="{Binding NotFinished, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="{markup:Tr Splyt_Intro}" TextWrapping="Wrap" FontSize="12" LineHeight="19"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" />

                        <!-- Identifiants : indispensables pour installer quoi que ce soit
                             DANS l'invite (exigence de Windows, pas de SPLYT). -->
                        <StackPanel Visibility="{Binding NotFinished, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{markup:Tr VmList_Credentials_UsernameLabel}" FontSize="12"
                                       TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />

                            <TextBlock Text="{markup:Tr VmList_Credentials_PasswordLabel}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <PasswordBox x:Name="PasswordInput" Margin="0,6,0,12" Padding="10,8"
                                         Background="{StaticResource SurfaceElevatedBrush}"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" />

                            <CheckBox Content="{markup:Tr VmList_Credentials_Remember}" IsChecked="{Binding RememberCredentials}"
                                      Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />

                            <CheckBox Content="{markup:Tr Splyt_AutoLogon_Option}" IsChecked="{Binding EnableAutoLogon}"
                                      Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="{markup:Tr Splyt_AutoLogon_Note}" FontSize="11" TextWrapping="Wrap"
                                       Margin="0,0,0,10" Foreground="{StaticResource TextMutedBrush}" />

                            <TextBlock Text="{markup:Tr VmList_Credentials_StorageNote}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMutedBrush}" />

                            <!-- Peripheriques a dedier a la VM. Seul reglage de cette
                                 fenetre qui exige quelque chose AVANT de cliquer : le
                                 materiel doit deja etre branche. -->
                            <Separator Margin="0,16,0,14" Background="{StaticResource BorderBrush2}" />

                            <TextBlock Text="{markup:Tr Splyt_Usb_Title}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                            <TextBlock Text="{markup:Tr Splyt_Usb_Note}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />

                            <TextBlock Text="{markup:Tr Splyt_Usb_Unavailable}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Visibility="{Binding UsbPickerUnavailable, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <ItemsControl ItemsSource="{Binding UsbDevices}"
                                          Visibility="{Binding UsbPickerAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,0,8"
                                                  Foreground="{StaticResource TextSecondaryBrush}">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Temoin d'identification : bouger la souris ou
                                                     appuyer sur une touche allume sa ligne. -->
                                                <!-- Fill pose par le style, jamais en attribut :
                                                     une valeur locale l'emporte sur les
                                                     declencheurs (voir VmListView). -->
                                                <Ellipse Width="9" Height="9" Margin="0,0,9,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource BorderBrush2}" />
                                                            <Setter Property="Opacity" Value="0.45" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                                    <Setter Property="Opacity" Value="1" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding IdentityText}" FontSize="10.5" FontFamily="Consolas"
                                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" FontSize="11.5" LineHeight="18"
                                   FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding ResultText, Converter={StaticResource NullToVisibilityConverter}}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
