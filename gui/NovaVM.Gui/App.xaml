<Application x:Class="NovaVM.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:NovaVM.Gui.Converters"
             xmlns:vm="clr-namespace:NovaVM.Gui.ViewModels"
             xmlns:views="clr-namespace:NovaVM.Gui.Views"
             xmlns:controls="clr-namespace:NovaVM.Gui.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WPF-UI d'abord : theme Fluent sombre + styles implicites des controles standards. -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <!-- Notre palette/styles ensuite : ce qui est cle ici (AccentButtonStyle, CardStyle...)
                     s'utilise a la demande ; ce qui n'est pas cle (TextBox) remplace l'implicite WPF-UI. -->
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:VmStateToBrushConverter x:Key="VmStateToBrushConverter" />
            <converters:FallbackTextConverter x:Key="FallbackTextConverter" />
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:AppLanguageToLabelConverter x:Key="AppLanguageToLabelConverter" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <!-- Navigation ViewModel-first : chaque page de la barre laterale est un
                 ViewModel simple ; le DataTemplate associe indique a WPF quelle vue
                 (UserControl) utiliser pour l'afficher. -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:VmListViewModel}">
                <views:VmListView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GpuViewModel}">
                <views:GpuView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StorageViewModel}">
                <views:StorageView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:JournalViewModel}">
                <views:JournalView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CreateVmDialogViewModel}">
                <controls:CreateVmDialog />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SunshineCredentialsDialogViewModel}">
                <controls:SunshineCredentialsDialog />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:EnhancedSessionFixDialogViewModel}">
                <controls:EnhancedSessionFixDialog />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HyperVSetupDialogViewModel}">
                <controls:HyperVSetupDialog />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ConfirmDialogViewModel}">
                <controls:ConfirmDialog />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
