<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Palette NovaVM : fond anthracite, cartes legerement plus claires,
        accent teal (actions principales) + violet (metriques secondaires,
        ex. RAM), inspiree de la maquette de reference fournie.
    -->

    <Color x:Key="BackgroundColor">#12141A</Color>
    <Color x:Key="SurfaceColor">#1B1E26</Color>
    <Color x:Key="SurfaceElevatedColor">#242835</Color>
    <Color x:Key="BorderColor">#2C303C</Color>

    <Color x:Key="TextPrimaryColor">#F1F2F6</Color>
    <Color x:Key="TextSecondaryColor">#98A0B3</Color>
    <Color x:Key="TextMutedColor">#5C6377</Color>

    <Color x:Key="AccentColor">#2DD4BF</Color>
    <Color x:Key="AccentHoverColor">#5EEAD4</Color>
    <Color x:Key="AccentPressedColor">#14B8A6</Color>

    <Color x:Key="SecondaryAccentColor">#A78BFA</Color>

    <Color x:Key="SuccessColor">#34D399</Color>
    <Color x:Key="WarningColor">#FBBF24</Color>
    <Color x:Key="DangerColor">#F87171</Color>
    <Color x:Key="DangerHoverColor">#FCA5A5</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="BorderBrush2" Color="{StaticResource BorderColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />

    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="{StaticResource SecondaryAccentColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />

    <!-- Pastilles d'icone : un fond teinte par famille de reglage, pour que l'oeil
         retrouve une section sans lire son titre (processeur, memoire, GPU...).
         Volontairement tres desaturees : ce sont des reperes, pas des alertes. -->
    <SolidColorBrush x:Key="IconAccentBrush" Color="#1B3B39" />
    <SolidColorBrush x:Key="IconBlueBrush" Color="#1B2C4A" />
    <SolidColorBrush x:Key="IconPurpleBrush" Color="#2B2450" />
    <SolidColorBrush x:Key="IconNeutralBrush" Color="{StaticResource SurfaceElevatedColor}" />

    <!-- Piste non parcourue d'un slider. Volontairement plus claire que
         SurfaceElevated : les sliders vivent DANS des cartes de cette couleur, ou
         une piste de la meme teinte disparaissait purement et simplement. -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#3A4152" />

    <SolidColorBrush x:Key="IconAccentForeground" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="IconBlueForeground" Color="#6AA8FF" />
    <SolidColorBrush x:Key="IconPurpleForeground" Color="#A78BFA" />

</ResourceDictionary>
